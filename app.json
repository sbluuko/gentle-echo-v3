{
  "expo": {
    "name": "GentleEcho",
    "slug": "GentleEcho",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/GentleEchoLogo.png",
    "scheme": "gentleecho",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/GentleEchoLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gentleechov2.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Inner Wisdom uses the microphone so you can record a reflection and hear it echoed back with calm and clarity.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gentleechov2.app",
      "versionCode": 6,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/GentleEchoLogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8629d353-b1e8-46da-a3de-b42fc83374dc"
      }
    },
    "owner": "sbluuko"
  }
}
